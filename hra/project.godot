; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Termín byl včera – prototyp"
run/main_scene="res://game/rooms/namesti/room_namesti.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Globals="*uid://bp1n6nxpgph2s"
Cursor="*uid://c2pqh7ajiuiy0"
E="*uid://rda8wggldt5o"
R="*uid://ciufr3amc41et"
C="*uid://cbgjku0fqvr0b"
I="*uid://cwi2iq8vv2qv1"
D="*uid://edkc1mnudsq1"
A="*uid://cwmtasxkrjqx4"
G="*uid://blk6nfpfiqrd2"
T="*uid://30lm6k5s368s"
Jazyk="*res://game/jazyk.gd"
Ladeni="*res://nastroje/ladeni.gd"

[display]

window/size/viewport_width=1536
window/size/viewport_height=1024
window/size/window_width_override=1152
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/popochiu/editor/gizmos/plugin.cfg", "res://addons/popochiu/editor/importers/plugin.cfg", "res://addons/popochiu/plugin.cfg")

[input]

popochiu-interact={
&"deadzone": 0.5,
&"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":32,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}
popochiu-look={
&"deadzone": 0.5,
&"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":32,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":2,"canceled":false,"pressed":false,"double_click":false,"script":null)
